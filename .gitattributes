# Normalizacion de saltos de linea: el repo guarda LF en el indice.
# Los scripts bash quedan LF aunque el checkout sea en Windows
# (con CRLF, bash falla con `$'\r': command not found`).
* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
