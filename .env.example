# (19/10/2026) Plantilla: copiala a .env y completa las claves con valores fuertes.
# Las claves reales viven SOLO en .env (ignorado por git). Ver README-DOCKER.md.
# root queda solo para administracion por socket (contenedor db); la app usa
# balbu_app y los scripts de mantenimiento usan balbu_admin.
DB_HOST=db
DB_PORT=3306
DB_PORT_HOST=3307
DB_NAME=BALBU_TECH

# Usuario dedicado de la app (DML + EXECUTE sobre BALBU_TECH).
DB_USER=balbu_app
DB_PASSWORD=CAMBIAR-clave-fuerte-app

# Usuario de mantenimiento: import/seeds/check (ALL sobre BALBU_TECH).
DB_ADMIN_USER=balbu_admin
DB_ADMIN_PASSWORD=CAMBIAR-clave-fuerte-admin

# Clave de root (solo admin por socket: docker compose exec db ...).
DB_ROOT_PASSWORD=CAMBIAR-clave-fuerte-root
