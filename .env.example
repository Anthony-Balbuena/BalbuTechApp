# Copia a .env y ajusta la clave si quieres.
# La app C++ lee DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME (ver database.cpp).
# MariaDB usa MARIADB_* para inicializar. Manten DB_PASSWORD == MARIADB_ROOT_PASSWORD.
DB_HOST=db
DB_PORT=3306
DB_PORT_HOST=3307
DB_NAME=BALBU_TECH
DB_USER=root
DB_PASSWORD=linux01

MARIADB_DATABASE=BALBU_TECH
MARIADB_ROOT_PASSWORD=linux01
