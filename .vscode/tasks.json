{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar y Ejecutar BalbuTechApp",
            "command": "g++",
            "args": [
                "-std=c++14",
                "*.cpp",
                "-o",
                "main",
                "-lmysqlcppconn",
                "-lssl",
                "-lcrypto",
                "&&",
                "./main"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}