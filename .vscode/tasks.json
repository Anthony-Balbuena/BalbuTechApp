{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar y Ejecutar BalbuTechApp (Windows)",
            "command": "g++",
            "args": [
                "-std=c++14",
                "*.cpp",
                "-o",
                "main",
                "-lmysqlcppconn",
                "-lssl",
                "-lcrypto"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "type": "shell",
            "label": "Nativo: compilar con build.sh (Linux)",
            "command": "bash",
            "args": ["build.sh"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "shell",
            "label": "Docker: levantar (app + MariaDB 10.11)",
            "command": "docker",
            "args": ["compose", "up", "--build", "-d"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "shared"},
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Docker: compilar con g++ (todos los .cpp)",
            "command": "docker",
            "args": ["compose", "exec", "app", "bash", "build.sh"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {"reveal": "always", "panel": "shared"},
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "shell",
            "label": "Docker: importar modulos/*.sql en orden",
            "command": "docker",
            "args": ["compose", "exec", "app", "bash", "db/import.sh"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "shared"},
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Docker: crear admin + verificar SPs",
            "command": "docker",
            "args": ["compose", "exec", "app", "bash", "db/seed-admin.sh"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "shared"},
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Docker: ver tablas",
            "command": "docker",
            "args": ["compose", "exec", "app", "bash", "db/show-tables.sh"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "shared"},
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Docker: bajar",
            "command": "docker",
            "args": ["compose", "down"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "shared"},
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}